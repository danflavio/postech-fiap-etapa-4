{
  "name": "blogfiap-api",
  "version": "1.0.0",
  "type": "module",
  "description": "API REST do BlogFIAP - Postech FIAP Etapa 4",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "transform": {},
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 50,
